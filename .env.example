# Copy this file to `.env` in the project root and fill in values.
# `.env` is gitignored - never commit real keys.

# --- OpenAI (weather forecast primary) ---
# Preferred: set here. Alternative: one-line file `openai_api_key.txt` in project root (gitignored).
OPENAI_API_KEY=

# --- AccuWeather (weather fallback) ---
# Optional. Get a free key at https://developer.accuweather.com/
# Alternative: one-line file `accuweather_api_key.txt` in project root (gitignored).
ACCUWEATHER_API_KEY=

# --- Server ---
# ARECO_PORT=8765

# --- Online viewer sync (local pushes -> hosted viewer) ---
# Set BOTH of these on the local/trader machine to push, e.g. to a Render app.
# Must be https:// (the token is sent in a header; plain http would leak it).
ARECO_SYNC_REMOTE_URL=
# Shared secret. Set the SAME value here (pusher) and on the hosted Viewer
# (receiver) - generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ARECO_SYNC_TOKEN=
# How often the local app auto-pushes to the Viewer, in seconds (default 300 = 5 min, min 60).
# ARECO_SYNC_INTERVAL_SECONDS=300
# Set to 0 to disable the background auto-push loop entirely (manual "Sync now" button still works).
# ARECO_SYNC_AUTO=1
# Only for testing a Viewer on 127.0.0.1/localhost over plain http. Never set this in production.
# ARECO_SYNC_ALLOW_INSECURE=0

# --- Auth (login / roles) ---
# Required for signed sessions. Use a long random string in production.
# ARECO_SECRET_KEY=
# User accounts: default file data/users.json. On first run the app copies users.example.json from the project root if that file is missing (sample password: changeme).
# Replace hashes with: python -c "from werkzeug.security import generate_password_hash; print(generate_password_hash('your-password'))"
# Roles: admin (full access), nominator (nomination dashboard only), spectator (read-only reports & billing history).
# Admins manage accounts in App settings → User accounts (CRUD on data/users.json).
# ARECO_USERS_FILE=
# ARECO_USERS_SEED_FILE controls which *.example.json seeds a missing users file (default users.example.json,
# which includes admin + nominator + spectator). The hosted public Viewer (see render.yaml) sets this to
# users.viewer.example.json instead, so it only ever has a spectator account - never leave this unset on a
# public deployment, or admin credentials (and the env-editing/API-key-reading admin panel) become public.
# ARECO_USERS_SEED_FILE=
# ARECO_DATA_DIR overrides where data/ lives (e.g. a Render persistent Disk mount path). Defaults to <project>/data.
# ARECO_DATA_DIR=

# --- Settlement zip extraction (Billing panel) ---
# Master zip from the other app = no password.
# Passwords apply to: (1) inner _ARECO / _ARECOSS bundle zips, (2) each daily ARECO_Energy_* / ARECOSS_Energy_* zip.
# Same order as Excel Sheet1 B2 / B3 (try 1, then 2, then unencrypted). No trailing spaces. Restart Flask after edits.
ARECO_SETTLEMENT_ZIP_PASSWORD1=
ARECO_SETTLEMENT_ZIP_PASSWORD2=

ARECO_NOMINATION_EXPORT_DIR=
